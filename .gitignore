# =============================================================================
# .gitignore — дополненная версия
#
# Что добавилось к текущему файлу: артефакты ML, .env, кеши инструментов
# (mypy, ruff, pytest), отчёты покрытия, настройки IDE.
# =============================================================================

# --- Виртуальные окружения -------------------------------------------------
# ВАЖНО: виртуальное окружение в Git НЕ коммитится.
# В репозиторий попадают pyproject.toml и poetry.lock —
# именно они воспроизводимо описывают окружение.
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Тесты и качество кода -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# --- Poetry ----------------------------------------------------------------
# Кеш Poetry; а poetry.lock, наоборот, коммитим обязательно
.poetry-cache/
poetry.toml

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints

# --- IDE / редакторы -------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# --- ОС --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Секреты и переменные окружения ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Данные и артефакты ML -------------------------------------------------
# Сырые данные и чекпоинты моделей в Git не храним —
# для них есть DVC / S3 / Git LFS.
data/
raw_data/
models/
checkpoints/
artifacts/
*.ckpt
*.pkl
*.joblib
*.h5
*.onnx

# --- Логи ------------------------------------------------------------------
*.log
logs/
